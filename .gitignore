# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IDE
.idea/
.vscode/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temp files
*.tmp
*.bak
*.swp
*.log

# Large file archives
*.gz
*.zip
*.tar

# Test / scratch output
test_output/
scratch/

# Per-domain: raw data and intermediate outputs are NOT committed.
# Only .gitkeep and curated sample files belong in data/.
*/data/raw/*
!*/data/raw/.gitkeep
*/data/output/
*/data/processed/rna/

# Top-level data/ is a non-canonical working dir (raw downloads + duplicate
# tables). The single source of truth is <domain>/release/external/. Never commit it.
/data/

# Pipeline caches and smoke outputs
*/pipelines/**/.cache/
*/pipelines/**/data/raw/
*/pipelines/**/reports/*.smoke.tsv

# Allow tracked JSON reports in interaction pipelines (override the report exclusion)
!*/pipelines/ppi_semantic_enrichment/reports/
!*/pipelines/ppi_semantic_enrichment/reports/*.json
!*/pipelines/psi_activity_structure_enrichment/reports/
!*/pipelines/psi_activity_structure_enrichment/reports/*.json
!*/pipelines/rpi_site_domain_enrichment/reports/
!*/pipelines/rpi_site_domain_enrichment/reports/*.json
!*/pipelines/interaction_cross_validation/reports/
!*/pipelines/interaction_cross_validation/reports/*.json
!*/pipelines/interaction_ontology_mapping/reports/
!*/pipelines/interaction_ontology_mapping/reports/*.json
!*/pipelines/interaction_release_local/reports/
!*/pipelines/interaction_release_local/reports/*.json
!*/pipelines/psi_condition_enrichment/reports/
!*/pipelines/psi_condition_enrichment/reports/*.json

# Local release packaging
/dist/

# Curated mirna compressed subset (tracked exception)
!rna/data/output/rna/rna_master_mirna_v1.tsv.gz
!rna/release/external/rna-v1/tables/sequence/rna_master_mirna_v1.tsv.gz
