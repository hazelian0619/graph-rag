{
  "name": "disease_gene_target_v1",
  "description": "Unified disease-gene / disease-target edge set (disease-layer-v1). Implementation converges to one edge table; product semantics preserved via relation_semantics/target_type (D-GATE-3, default-applied). Aligned to FR-004 / FR-015 / FR-016.",
  "required_columns": [
    "disease_id",
    "target_id",
    "relation_semantics",
    "target_type",
    "source",
    "evidence_class"
  ],
  "rules": [
    {
      "id": "disease_id_non_empty",
      "type": "non_empty_rate",
      "column": "disease_id",
      "min_rate": 1.0
    },
    {
      "id": "disease_id_mondo_format",
      "type": "regex_rate",
      "column": "disease_id",
      "pattern": "^MONDO:\\d{7}$",
      "min_rate": 1.0
    },
    {
      "id": "target_id_non_empty",
      "type": "non_empty_rate",
      "column": "target_id",
      "min_rate": 1.0
    },
    {
      "id": "relation_semantics_allowed",
      "type": "allowed_values_rate",
      "column": "relation_semantics",
      "allowed": ["disease_gene", "disease_target"],
      "min_rate": 1.0
    },
    {
      "id": "target_type_allowed",
      "type": "allowed_values_rate",
      "column": "target_type",
      "allowed": ["gene", "protein_target"],
      "min_rate": 1.0
    },
    {
      "id": "source_non_empty",
      "type": "non_empty_rate",
      "column": "source",
      "min_rate": 1.0
    },
    {
      "id": "evidence_class_allowed",
      "type": "allowed_values_rate",
      "column": "evidence_class",
      "allowed": ["curated_association", "inferred_mapping", "therapeutic_evidence"],
      "min_rate": 1.0
    }
  ]
}
