{
  "name": "disease_phenotype_v1",
  "description": "Disease-phenotype edge table (disease-layer-v1). HPO-only bridge between disease (MONDO) and phenotype (HPO). Aligned to FR-005 / FR-009 / FR-016.",
  "required_columns": [
    "disease_id",
    "hpo_id",
    "source",
    "evidence_class"
  ],
  "rules": [
    {
      "id": "disease_id_non_empty",
      "type": "non_empty_rate",
      "column": "disease_id",
      "min_rate": 1.0
    },
    {
      "id": "disease_id_mondo_format",
      "type": "regex_rate",
      "column": "disease_id",
      "pattern": "^MONDO:\\d{7}$",
      "min_rate": 1.0
    },
    {
      "id": "hpo_id_non_empty",
      "type": "non_empty_rate",
      "column": "hpo_id",
      "min_rate": 1.0
    },
    {
      "id": "hpo_id_format",
      "type": "regex_rate",
      "column": "hpo_id",
      "pattern": "^HP:\\d{7}$",
      "min_rate": 1.0
    },
    {
      "id": "source_non_empty",
      "type": "non_empty_rate",
      "column": "source",
      "min_rate": 1.0
    },
    {
      "id": "evidence_class_allowed",
      "type": "allowed_values_rate",
      "column": "evidence_class",
      "allowed": ["curated_association", "inferred_mapping"],
      "min_rate": 1.0
    }
  ]
}
