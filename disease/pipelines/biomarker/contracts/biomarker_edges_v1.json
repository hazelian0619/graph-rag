{
  "name": "biomarker_edges_v1",
  "description": "Biomarker first-pass relation layer (disease-layer-v1). Derived from high-value disease-gene/protein mappings (D-GATE-4). bridge_only by default. Aligned to FR-003/FR-007/FR-015/FR-016.",
  "required_columns": [
    "biomarker_id",
    "biomarker_type",
    "disease_id",
    "target_id",
    "source",
    "evidence_class"
  ],
  "rules": [
    {"id": "biomarker_id_non_empty", "type": "non_empty_rate", "column": "biomarker_id", "min_rate": 1.0},
{"id": "biomarker_type_allowed", "type": "allowed_values_rate", "column": "biomarker_type", "allowed": ["gene_biomarker", "protein_biomarker", "rna_biomarker"], "min_rate": 1.0},
    {"id": "disease_id_mondo_format", "type": "regex_rate", "column": "disease_id", "pattern": "^MONDO:\\d{7}$", "min_rate": 1.0},
    {"id": "target_id_non_empty", "type": "non_empty_rate", "column": "target_id", "min_rate": 1.0},
    {"id": "source_non_empty", "type": "non_empty_rate", "column": "source", "min_rate": 1.0},
    {"id": "evidence_class_allowed", "type": "allowed_values_rate", "column": "evidence_class", "allowed": ["bridge_only", "evidence_backed"], "min_rate": 1.0}
  ]
}
